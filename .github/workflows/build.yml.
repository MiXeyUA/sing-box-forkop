
name: Build Forkop for MSM8916

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y apk-tools

      - name: Setup Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod

      - name: Build Forkop
        run: |
          chmod +x build.sh
          ./build.sh \
            --arch aarch64_generic \
            --variant base \
            --format apk

      - name: Upload package
        uses: actions/upload-artifact@v4
        with:
          name: forkop-msm8916
          path: dist/*.apk
          if-no-files-found: error
          retention-days: 14
